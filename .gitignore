/target
crates/**/target/
**/*.rs.bk
Cargo.lock.orig

# Runtime workspace artifacts (managed projects live elsewhere)
/state/
/logs/
/codebase/
# Local snapshots of hub state (spaces/workspace/system_chat) — machine-local
/backups/

.DS_Store

# Local auth store — hashed credentials, never commit
auth.json
**/auth.json
sessions.json
**/sessions.json

# Filled-in deploy secrets (COX-B030). `.env` carries the admin password and
# every backing-service credential — it is per-environment, never committed.
# Only the placeholder template `.env.example` belongs in git.
.env
!.env.example
# Rotation backups hold the PREVIOUS live credentials — same secrecy as `.env`.
.env.bak.*
.env.*.bak
# Any local-only note (credentials, host-specific ports) never belongs in git.
*.local.md
# Host-specific compose overlay: absolute paths that exist on one machine only.
*.local.yml

# Runtime state of the compose deploy's mounted volume: nightly backups and the
# hand-edited copies left beside a file before changing it. Per-install data.
deploy/volume/**/backups/
*.bak

# An MCP client config carries a live Bearer token for this install.
cox-opencode.json

# Per-install desktop admin password, generated on first launch (0600).
admin-password

# Per-agent git worktrees: whole checkouts with their own target/, tens of GB.
# Never committed, and excluded from the docker build context too — see
# .dockerignore, where their target/ dirs once sank the release build.
.claude/worktrees/

# macOS app build artifacts
desktop/build/
/dist/
node_modules/
/data/registry.json
/data/coordination.json

# generated per-machine by the code-knowledge indexer
.coxagent/
test-results/

# SwiftPM build dir (companion)
.build/
opencode.json

# Per-agent git worktrees: whole checkouts with their own target/, tens of GB.
.coxagent-worktrees/

# Python bytecode caches — never commit compiled artifacts (they were swept
# into a branch once and polluted a merge). Rebuilt at runtime by the interpreter.
__pycache__/
**/__pycache__/
*.pyc

# Self-upgrade runtime state: written by deploy/self-upgrade.sh each run.
.coxagent-self-upgrade/

# Nested scratch repo / "merge test" clones a worker creates; must never be
# swept into a PR as a gitlink (mode 160000) — that broke CI + the visual-qa
# gate. See PRs #220/#223/#224.
mergetest/
/mergetest/
