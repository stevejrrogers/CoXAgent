/target
**/*.rs.bk
Cargo.lock.orig

# Runtime workspace artifacts (managed projects live elsewhere)
/state/
/logs/
/codebase/
# Local snapshots of hub state (spaces/workspace/system_chat) — machine-local
/backups/

.DS_Store

# Local auth store — hashed credentials, never commit
auth.json
**/auth.json
sessions.json
**/sessions.json

# Filled-in deploy secrets (COX-B030). `.env` carries the admin password and
# every backing-service credential — it is per-environment, never committed.
# Only the placeholder template `.env.example` belongs in git.
.env
!.env.example

# Per-install desktop admin password, generated on first launch (0600).
admin-password

# macOS app build artifacts
desktop/build/
/dist/
node_modules/
/data/registry.json
/data/coordination.json

# generated per-machine by the code-knowledge indexer
.coxagent/
test-results/

# SwiftPM build dir (companion)
.build/
opencode.json
