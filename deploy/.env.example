# Copy to .env and fill in. All values are required.
#
# THIS FILE is the template and is committed. The `.env` you create from it is
# NOT: it holds live credentials and is gitignored (COX-B030 — a real admin
# password was once committed here). Generate every secret below, never reuse
# the placeholder text, and rotate anything that has ever been shared.
#   scripts/rotate-admin-password.sh   # generates ADMIN_PASSWORD into ./.env
DOMAIN=chat.example.com          # DNS A-record must point at this host
PUBLIC_IP=203.0.113.10           # this server's public IP (for coturn + TURN URL)

ADMIN_USER=root
ADMIN_PASSWORD=change-me-to-a-strong-password

S3_ACCESS_KEY=coxagent
S3_SECRET_KEY=change-me-minio-secret

MONGO_USER=coxagent
MONGO_PASSWORD=change-me-mongo-password

# Shared state (Postgres) + coordination (Redis) for the distributed runtime.
PG_USER=coxagent
PG_PASSWORD=change-me-postgres-password

# Redis holds live sessions (native TTL), so an unauthenticated Redis is a
# straight authentication bypass: whoever reads a `cox:auth:session:*` value is
# signed in as its owner. This is REQUIRED, never blank.
REDIS_PASSWORD=change-me-redis-password

TURN_SECRET=change-me-turn-shared-secret

# --- Self-host overlay (optional) -------------------------------------------
# When the hub runs in Docker but the projects and their codebases live on this
# machine, the container must see the host's OWN absolute paths: a project's
# `codebase` is a symlink, and a symlink resolves only if its target path also
# exists inside the container. Copy docker-compose.local.yml.example (or write
# your own), set the two paths below, and COMPOSE_FILE loads it automatically.
#COMPOSE_FILE=docker-compose.split.yml:docker-compose.local.yml
#COX_WORKSPACE=/Users/you/CoXAgent      # holds registry.json + per-project state
#COX_CODE_ROOT=/Users/you/Projects      # mounted read-only; agents write via the runner
