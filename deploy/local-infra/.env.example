# Local backing-services template. Copy to deploy/local-infra/.env and fill in
# real values before running docker compose up. The filled-in .env is gitignored
# — never commit it.
#
#   cp deploy/local-infra/.env.example deploy/local-infra/.env
#   # edit deploy/local-infra/.env with real credentials
#   source deploy/local-infra/.env
#   docker compose -f deploy/local-infra/docker-compose.yml up -d

PG_USER=coxagent
PG_PASSWORD=change-me-postgres-password

MINIO_ROOT_USER=coxagent
MINIO_ROOT_PASSWORD=change-me-minio-password
